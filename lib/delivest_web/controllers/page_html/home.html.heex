<div class="min-h-screen bg-base-100 text-base-content flex flex-col">
  <header class="sticky top-0 z-50 border-b border-base-300 bg-base-100/90 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3 sm:px-6">
      <a href="/" class="flex flex-1 items-center gap-2 text-xl font-extrabold tracking-tight">
        <span class="grid size-9 place-items-center rounded-xl bg-primary text-primary-content">
          <.icon name="hero-shopping-bag" class="size-5" />
        </span>
        Delivest
      </a>

      <% current_locale = Gettext.get_locale(DelivestWeb.Gettext) %>
      <.link
        href={if current_locale == "ru", do: ~p"/locale/en", else: ~p"/locale/ru"}
        class="btn btn-ghost btn-sm font-medium"
      >
        {if current_locale == "ru", do: "EN", else: "RU"}
      </.link>

      <label class="btn btn-ghost btn-sm btn-square swap swap-rotate">
        <input
          type="checkbox"
          id="theme-toggle"
          phx-hook="ThemeToggle"
          class="theme-controller hidden"
          value="dark"
        />
        <.icon name="hero-sun" class="swap-off size-5" />
        <.icon name="hero-moon" class="swap-on size-5" />
      </label>

      <.link
        href={if @current_staff, do: ~p"/staff", else: ~p"/staff/auth/login"}
        class="btn btn-primary btn-sm sm:btn-md"
      >
        <.icon name="hero-arrow-right-end-on-rectangle" class="size-5" />
        {if @current_staff, do: gettext("Open control panel"), else: gettext("Sign In")}
      </.link>
    </div>
  </header>

  <main class="flex-1">
    <section class="bg-linear-to-b from-base-200/60 to-base-100">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[1.1fr_1fr] lg:py-24">
        <div>
          <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-primary">
            {gettext("Food ordering and delivery platform")}
          </p>
          <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-balance sm:text-5xl">
            {gettext("Orders, menu and branches of your restaurant in one place")}
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-base-content/70">
            {gettext(
              "Customers order from the website and follow the status of their order. Staff take orders, manage the menu and see what happens in every branch. Works on its own or together with your CRM."
            )}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <.link
              href={if @current_staff, do: ~p"/staff", else: ~p"/staff/auth/login"}
              class="btn btn-primary btn-lg"
            >
              {if @current_staff,
                do: gettext("Open control panel"),
                else: gettext("Sign in to the control panel")}
              <.icon name="hero-arrow-right" class="size-5" />
            </.link>
            <a href="#features" class="btn btn-ghost btn-lg">{gettext("What it can do")}</a>
          </div>

          <p :if={@current_staff} class="mt-4 text-sm text-base-content/60">
            {gettext("You are signed in as %{name}",
              name: @current_staff.name || @current_staff.login
            )}
          </p>
        </div>

        <div class="relative" aria-hidden="true">
          <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-xl">
            <div class="mb-4 flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-wider text-base-content/50">
                  {gettext("Example order")}
                </p>
                <p class="text-lg font-bold">#A042</p>
              </div>
              <span class="badge badge-primary">{gettext("Preparing")}</span>
            </div>

            <ol class="space-y-3">
              <li
                :for={
                  {label, state} <- [
                    {gettext("Accepted"), :done},
                    {gettext("Preparing"), :current},
                    {gettext("Delivering"), :next}
                  ]
                }
                class="flex items-center gap-3"
              >
                <span class={[
                  "grid size-9 place-items-center rounded-xl",
                  state == :done && "bg-primary/15 text-primary",
                  state == :current && "bg-primary text-primary-content",
                  state == :next && "bg-base-200 text-base-content/40"
                ]}>
                  <.icon
                    name={if state == :done, do: "hero-check", else: "hero-clock"}
                    class="size-5"
                  />
                </span>
                <span class={[state == :next && "text-base-content/40", "font-medium"]}>
                  {label}
                </span>
              </li>
            </ol>

            <div class="mt-5 grid grid-cols-3 gap-2 border-t border-base-300 pt-4 text-center">
              <div>
                <p class="text-xl font-bold tabular-nums">24</p>
                <p class="text-xs text-base-content/60">{gettext("orders today")}</p>
              </div>
              <div>
                <p class="text-xl font-bold tabular-nums">3</p>
                <p class="text-xs text-base-content/60">{gettext("branches")}</p>
              </div>
              <div>
                <p class="text-xl font-bold tabular-nums">CRM</p>
                <p class="text-xs text-base-content/60">{gettext("in sync")}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="scroll-mt-20 border-t border-base-300 py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="text-3xl font-bold tracking-tight text-balance">
          {gettext("Everything a restaurant needs to take orders")}
        </h2>
        <p class="mt-3 max-w-2xl text-base-content/70">
          {gettext(
            "The basics work out of the box. Integrations are switched on per branch when you need them."
          )}
        </p>

        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div
            :for={
              {icon, title, text} <- [
                {"hero-device-phone-mobile", gettext("Online menu and cart"),
                 gettext(
                   "Categories, product cards with photos, promotions and checkout with delivery, pickup or dine-in."
                 )},
                {"hero-clock", gettext("Order statuses for customers"),
                 gettext(
                   "Customers see their active orders right on the website, from acceptance to delivery."
                 )},
                {"hero-building-storefront", gettext("Several branches"),
                 gettext(
                   "Own menu, working hours, contacts and map for each branch. Products are copied between branches in a few clicks."
                 )},
                {"hero-arrows-right-left", gettext("CRM integration"),
                 gettext(
                   "Orders go to Frontpad automatically, statuses come back by webhook, prices and products are checked every hour."
                 )},
                {"hero-shield-check", gettext("Roles and access"),
                 gettext(
                   "Each employee sees only their branches and sections. Blocked customers cannot place orders."
                 )},
                {"hero-document-magnifying-glass", gettext("Event log"),
                 gettext("Who did what and when, application logs and errors in one section.")},
                {"hero-chart-bar", gettext("Statistics"),
                 gettext(
                   "Revenue, average check, orders by day and hour, best-selling products and categories."
                 )},
                {"hero-document-arrow-up", gettext("Product import"),
                 gettext("Load the whole menu from a CSV file instead of entering it by hand.")},
                {"hero-shopping-cart", gettext("Orders from the admin panel"),
                 gettext(
                   "Staff take phone orders in the same system and edit them while they are open."
                 )}
              ]
            }
            class="rounded-box border border-base-300 p-6"
          >
            <span class="mb-4 grid size-11 place-items-center rounded-xl bg-primary/10 text-primary">
              <.icon name={icon} class="size-6" />
            </span>
            <h3 class="font-bold">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-base-content/70">{text}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-base-300 bg-base-200/40 py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="text-3xl font-bold tracking-tight">{gettext("How to get started")}</h2>
        <ol class="mt-10 grid gap-6 md:grid-cols-3">
          <li
            :for={
              {step, title, text} <- [
                {1, gettext("Set up a branch"),
                 gettext("Address, working hours, contacts and, if needed, the CRM connection.")},
                {2, gettext("Fill in the menu"),
                 gettext(
                   "Create categories and products, import them from CSV or copy from another branch."
                 )},
                {3, gettext("Accept orders"),
                 gettext(
                   "Orders from the website and from staff appear in one list with live statuses."
                 )}
              ]
            }
            class="flex gap-4"
          >
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-primary font-bold text-primary-content">
              {step}
            </span>
            <div>
              <h3 class="font-bold">{title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-base-content/70">{text}</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="py-20">
      <div class="mx-auto flex max-w-4xl flex-col items-center gap-6 rounded-box bg-primary px-6 py-12 text-center text-primary-content sm:px-12">
        <h2 class="text-3xl font-bold tracking-tight text-balance">
          {gettext("Ready to work?")}
        </h2>
        <p class="max-w-xl opacity-90">
          {gettext("Sign in with the login and password issued by your administrator.")}
        </p>
        <.link
          href={if @current_staff, do: ~p"/staff", else: ~p"/staff/auth/login"}
          class="btn btn-lg bg-base-100 text-base-content hover:bg-base-200 border-0"
        >
          {if @current_staff,
            do: gettext("Open control panel"),
            else: gettext("Sign in to the control panel")}
          <.icon name="hero-arrow-right" class="size-5" />
        </.link>
      </div>
    </section>
  </main>

  <footer class="border-t border-base-300 py-8">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 text-sm text-base-content/60 sm:px-6">
      <p>Delivest © 2026. {gettext("All rights reserved.")}</p>
      <.link href={~p"/staff/auth/login"} class="link link-hover">{gettext("Staff sign in")}</.link>
    </div>
  </footer>
</div>
