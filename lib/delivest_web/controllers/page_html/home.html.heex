<div class="min-h-screen bg-base-100 text-base-content flex flex-col">
  <header class="navbar bg-base-100 border-b border-base-300 px-6 lg:px-12 sticky top-0 z-50">
    <div class="flex-1">
      <a
        href="/"
        class="text-xl font-extrabold tracking-tight text-primary flex items-center gap-2"
      >
        <.icon name="hero-shopping-bag" class="w-6 h-6" /> Delivest
      </a>
    </div>

    <div class="flex items-center gap-4">
      <% current_locale = Gettext.get_locale(DelivestWeb.Gettext) %>
      <.link
        :if={current_locale == "ru"}
        href={~p"/locale/en"}
        class="flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium border border-base-300 rounded-lg bg-base-100 hover:bg-base-200 text-base-content transition-colors"
      >
        <span>🇬🇧</span>
        <span>EN</span>
      </.link>

      <.link
        :if={current_locale == "en"}
        href={~p"/locale/ru"}
        class="flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium border border-base-300 rounded-lg bg-base-100 hover:bg-base-200 text-base-content transition-colors"
      >
        <span>🇷🇺</span>
        <span>RU</span>
      </.link>

      <label class="btn btn-ghost btn-sm btn-square swap swap-rotate min-h-9 h-9 w-9">
        <input
          type="checkbox"
          id="theme-toggle"
          phx-hook="ThemeToggle"
          class="theme-controller hidden"
          value="dark"
        />
        <.icon name="hero-sun" class="swap-off h-5 w-5" />
        <.icon name="hero-moon" class="swap-on h-5 w-5" />
      </label>

      <div class="h-4 w-px bg-base-300 hidden sm:block"></div>

      <.link href={~p"/staff/auth/login"} class="btn btn-primary btn-sm sm:btn-md gap-2 shadow-sm">
        <.icon name="hero-user-circle" class="w-5 h-5" />
        {gettext("Control Panel")}
      </.link>
    </div>
  </header>

  <section class="hero flex-1 bg-linear-to-b from-base-200/40 to-base-100 py-28 px-6">
    <div class="hero-content text-center max-w-4xl mx-auto">
      <div>
        <div class="badge badge-primary badge-outline mb-6 px-4 py-3 font-medium text-sm">
          {gettext("Enterprise Platform for Restaurant Business")}
        </div>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6 leading-tight">
          {gettext("Integrated System")} <br />
          <span class="text-primary">{gettext("for Food Ordering & Delivery")}</span>
        </h1>
        <p class="py-4 text-lg sm:text-xl text-base-content/70 max-w-2xl mx-auto leading-relaxed">
          {gettext(
            "Delivest combines client-facing interfaces, a modern CRM system, and a centralized control panel for efficient management of all business operations."
          )}
        </p>
        <div class="flex flex-wrap justify-center gap-4 mt-8">
          <.link href={~p"/staff/auth/login"} class="btn btn-primary btn-lg gap-2 shadow-md">
            {gettext("Sign In")}
            <.icon name="hero-arrow-right" class="w-5 h-5" />
          </.link>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-base-200/30 border-t border-base-300">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
          {gettext("Platform Architecture")}
        </h2>
        <p class="text-base-content/70 max-w-xl mx-auto text-base">
          {gettext("Professional tools designed to automate every step of your service delivery.")}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="card bg-base-100 border border-base-300 shadow-sm p-8">
          <div class="w-14 h-14 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6">
            <.icon name="hero-device-phone-mobile" class="w-7 h-7" />
          </div>
          <h3 class="text-xl font-bold mb-3">{gettext("Client Application")}</h3>
          <p class="text-base-content/70 text-sm leading-relaxed">
            {gettext(
              "An interface for end-users featuring an interactive menu, cart, order placement, and real-time delivery status tracking."
            )}
          </p>
        </div>

        <div class="card bg-base-100 border border-base-300 shadow-sm p-8">
          <div class="w-14 h-14 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6">
            <.icon name="hero-users" class="w-7 h-7" />
          </div>
          <h3 class="text-xl font-bold mb-3">{gettext("CRM System")}</h3>
          <p class="text-base-content/70 text-sm leading-relaxed">
            {gettext(
              "Customer base management, order history tracking, and analytics tools designed to increase audience loyalty."
            )}
          </p>
        </div>

        <div class="card bg-base-100 border border-base-300 shadow-sm p-8">
          <div class="w-14 h-14 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6">
            <.icon name="hero-squares-2x2" class="w-7 h-7" />
          </div>
          <h3 class="text-xl font-bold mb-3">{gettext("Control Panel")}</h3>
          <p class="text-base-content/70 text-sm leading-relaxed">
            {gettext(
              "Branch administration, staff role configuration, product catalog setup, and operational workflow control."
            )}
          </p>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer footer-center p-10 bg-base-100 border-t border-base-300 text-base-content">
    <div>
      <p class="font-bold flex items-center gap-1">
        Delivest <span class="text-primary">© 2026</span>
      </p>
      <p class="text-sm text-base-content/60">
        {gettext("All rights reserved.")}
      </p>
    </div>
  </footer>
</div>
