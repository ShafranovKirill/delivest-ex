<div class="drawer min-h-screen bg-base-200 text-base-content">
  <input id="staff-drawer" type="checkbox" class="drawer-toggle" />

  <div class="drawer-content flex min-h-screen flex-col">
    <DelivestWeb.StaffHeader.staff_header
      current_staff={@current_staff}
      current_branch={assigns[:current_branch]}
    />

    <main class="flex-1 p-6 pt-16">
      <div class="max-w-7xl mx-auto">
        <.flash_group flash={@flash} />
        {@inner_content}
      </div>
    </main>
  </div>

  <DelivestWeb.StaffSidebar.staff_sidebar
    current_staff={@current_staff}
    current_page={assigns[:current_page]}
  />
</div>
