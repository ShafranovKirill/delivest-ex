<% page_header = DelivestWeb.StaffHeader.page_header(assigns) %>
<% branches = assigns[:staff_branches] || [] %>
<% accessible_branch = fn candidate ->
  if candidate && Map.get(candidate, :id) && Map.get(candidate, :slug) do
    if Enum.any?(branches, &(&1.id == candidate.id)), do: candidate
  end
end %>
<% settings_branch =
  Enum.find_value(
    [assigns[:settings_scope_branch], assigns[:selected_branch], assigns[:branch]],
    accessible_branch
  ) %>
<% actual_scope_branch =
  DelivestWeb.StaffHeader.scope_branch(
    assigns[:current_path],
    assigns[:current_branch],
    settings_branch
  ) %>
<% navigation_branch =
  actual_scope_branch ||
    Enum.find_value(
      [assigns[:navigation_branch], settings_branch, assigns[:current_branch]],
      accessible_branch
    ) || List.first(branches) %>
<div class={[
  "min-h-screen bg-base-200 text-base-content",
  assigns[:foundation_workspace] && "foundation-shell"
]}>
  <div id="staff-dirty-guard" phx-hook="StaffDirtyGuard" phx-update="ignore">
    <dialog id="staff-unsaved-dialog" class="modal" aria-labelledby="staff-unsaved-title">
      <div class="modal-box max-w-md">
        <h2 id="staff-unsaved-title" class="text-lg font-semibold">
          {gettext("Unsaved changes")}
        </h2>
        <p class="mt-2 text-sm text-base-content/70">
          {gettext("Leave this page and discard your changes?")}
        </p>
        <div class="modal-action">
          <button id="staff-unsaved-stay" type="button" class="btn btn-ghost">{gettext("Stay")}</button>
          <button id="staff-unsaved-leave" type="button" class="btn btn-error">{gettext("Leave")}</button>
        </div>
      </div>
    </dialog>
  </div>
  <DelivestWeb.StaffHeader.staff_header
    current_staff={@current_staff}
    current_branch={assigns[:current_branch]}
    staff_branches={assigns[:staff_branches] || []}
    current_path={assigns[:current_path]}
    current_uri={assigns[:current_uri]}
    settings_branch={settings_branch}
    page_title={assigns[:page_title]}
    workspace={assigns[:foundation_workspace] || false}
    kitchen_status={assigns[:kitchen_status]}
  />

  <DelivestWeb.CommandPalette.command_palette
    query={assigns[:command_query] || ""}
    groups={assigns[:command_groups] || []}
  />

  <DelivestWeb.OverdueOrdersAlert.overdue_orders_alert orders={assigns[:overdue_orders] || []} />
  <DelivestWeb.KitchenControl.kitchen_late_alert orders={assigns[:kitchen_late_orders] || []} />
  <DelivestWeb.ChannelCancelAlert.channel_cancel_alert orders={
    assigns[:channel_cancelled_orders] || []
  } />

  <DelivestWeb.StaffSidebar.staff_sidebar
    current_staff={@current_staff}
    current_branch={assigns[:current_branch]}
    scope_branch={actual_scope_branch}
    navigation_branch={navigation_branch}
    staff_branches={assigns[:staff_branches] || []}
    current_path={assigns[:current_path]}
    current_page={assigns[:current_page]}
    new_orders_count={assigns[:new_orders_count] || 0}
  />

  <div class="staff-shell-content flex min-h-screen flex-col transition-[margin] duration-300">
    <main class="flex-1 min-w-0 p-4 sm:p-6">
      <div class="max-w-7xl mx-auto">
        <.flash_group flash={@flash} />
        <%= if page_header do %>
          {page_header}
        <% else %>
          <%= if !assigns[:foundation_workspace] do %>
            <h1 class="mb-5 text-2xl font-semibold">
              {assigns[:page_title] || gettext("Dashboard")}
            </h1>
          <% end %>
        <% end %>
        <DelivestWeb.StaffNav.local_navigation
          staff={@current_staff}
          branch={assigns[:current_branch]}
          navigation_branch={navigation_branch}
          current_page={assigns[:current_page]}
          current_path={assigns[:current_path]}
        />
        <DelivestWeb.GatewayNote.gateway_note
          :if={assigns[:gateway_block]}
          name={@gateway_block.name}
          area={@gateway_block.area}
          branch={assigns[:current_branch]}
        />
        <div :if={!assigns[:gateway_block]}>{@inner_content}</div>
      </div>
    </main>
  </div>
</div>
